---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header';
import ScrollProgress from '@/components/ScrollProgress';
import Particles from '@/components/Particles';
import Hero from '@/components/sections/Hero.astro';
import Platform from '@/components/sections/Platform.astro';
import Developers from '@/components/sections/Developers.astro';
import Architecture from '@/components/sections/Architecture.astro';
import Roadmap from '@/components/sections/Roadmap.astro';
import Faq from '@/components/sections/Faq.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import Footer from '@/components/Footer.astro';
---
<BaseLayout>
  <ScrollProgress client:load />
  <Particles client:idle />
  <Header client:load />
  <main class="relative z-10">
    <Hero />
    <Platform />
    <Developers />
    <Architecture />
    <Roadmap />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</BaseLayout>
