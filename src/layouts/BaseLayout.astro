---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vanta — Modern multiplayer for San Andreas',
  description = 'Vanta is a modern multiplayer platform for Grand Theft Auto: San Andreas, built for players, server owners and developers.',
} = Astro.props;
---
<!doctype html>
<html lang="en" class="noise">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090806" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Vanta, Vanta MP, GTA San Andreas multiplayer, GTA SA multiplayer, C#, TypeScript, Astro, SolidJS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/vanta-logo.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/vanta-logo.png" />
    <link rel="apple-touch-icon" href="/vanta-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
