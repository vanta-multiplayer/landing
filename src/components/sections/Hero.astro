---
import { Badge } from '@/components/ui/Badge';
import { Button } from '@/components/ui/Button';
import { ArrowDown, ArrowUpRight, Braces, Hash } from 'lucide-solid';
---
<section id="home" class="relative isolate flex min-h-screen items-center overflow-hidden pt-28">
  <div class="hero-grid absolute inset-0 -z-20 opacity-65"></div>
  <div class="absolute left-[12%] top-[12%] -z-10 size-[28rem] rounded-full bg-primary/[.08] blur-[110px]"></div>
  <div class="absolute right-[5%] top-[28%] -z-10 size-[24rem] rounded-full bg-orange-800/[.08] blur-[120px]"></div>

  <div class="mx-auto grid w-full max-w-[1480px] items-center gap-14 px-5 pb-20 sm:px-8 lg:grid-cols-[1.05fr_.95fr] lg:px-10 lg:pb-10">
    <div class="max-w-3xl">
      <h1 class="font-display text-[clamp(3.6rem,8.4vw,8.8rem)] font-bold leading-[.79] tracking-[-.075em]">
        <span class="block text-white/95">San Andreas.</span>
        <span class="text-gradient block">Built forward.</span>
      </h1>
      <p class="mt-8 max-w-2xl text-base leading-8 text-muted sm:text-lg">
        Vanta is a modern multiplayer platform built from the ground up for Grand Theft Auto: San Andreas. Create servers, resources and interfaces with a modern development stack without losing the game that started it all.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <Button href="https://discord.gg/Xmmv5Zh446" target="_blank" rel="noreferrer">Join the community <ArrowUpRight class="size-4" /></Button>
        <Button variant="secondary" href="#platform">Explore the platform</Button>
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-semibold text-muted">
        <span class="flex items-center gap-2"><i class="size-2 animate-pulse-soft rounded-full bg-primary"></i> Early development</span>
        <span class="h-3 w-px bg-border"></span>
      </div>
    </div>

    <div class="relative mx-auto flex aspect-square w-full max-w-[650px] items-center justify-center lg:mr-0">
      <div class="absolute size-[70%] rounded-full border border-primary/10"></div>
      <div class="absolute size-[89%] animate-spin-slow rounded-full border border-dashed border-primary/10"></div>
      <div class="absolute size-[58%] rounded-full bg-primary/[.07] blur-3xl"></div>
      <img src="/vanta-logo.png" alt="Vanta" class="logo-shadow relative z-10 w-[69%] animate-float object-contain" />
      <div class="absolute left-[4%] top-[28%] flex items-center gap-2 rounded-md border border-border glass px-3 py-2 text-xs font-bold text-white shadow-2xl"><Braces class="size-3.5 text-primary" /> C#</div>
      <div class="absolute bottom-[22%] right-[2%] flex items-center gap-2 rounded-md border border-border glass px-3 py-2 text-xs font-bold text-white shadow-2xl"><Hash class="size-3.5 text-primary" /> TypeScript</div>
    </div>
  </div>

  <a href="#platform" class="absolute bottom-7 left-1/2 hidden -translate-x-1/2 items-center gap-2 text-[10px] font-bold uppercase tracking-[.22em] text-muted lg:flex">Discover Vanta <ArrowDown class="size-3.5 text-primary" /></a>
</section>
