---
import { Badge } from '@/components/ui/Badge';
---
<section id="developers" class="border-t border-border-soft py-28 sm:py-36">
  <div class="mx-auto grid max-w-[1480px] gap-14 px-5 sm:px-8 lg:grid-cols-[.88fr_1.12fr] lg:items-center lg:px-10">
    <div>
      <Badge>Built for developers</Badge>
      <h2 class="mt-6 font-display text-4xl font-bold leading-[1.02] tracking-[-.055em] sm:text-6xl">Use the stack<br /><span class="text-primary">you already know.</span></h2>
      <p class="mt-6 max-w-xl text-base leading-8 text-muted">Vanta aims to make San Andreas development feel familiar to modern software developers. Build gameplay in C# or TypeScript and create UI with standard web technologies.</p>
    </div>

    <div class="overflow-hidden rounded-lg border border-border bg-[#0c0b09] shadow-[0_30px_100px_rgba(0,0,0,.32)]">
      <div class="flex items-center border-b border-border-soft bg-white/[.02] px-4 py-3">
        <div class="flex gap-1.5"><i class="size-2.5 rounded-full bg-[#ff6b59]"></i><i class="size-2.5 rounded-full bg-[#ffc247]"></i><i class="size-2.5 rounded-full bg-[#6bd879]"></i></div>
        <span class="mx-auto text-xs font-semibold text-muted">PlayerSpawn.cs</span>
        <small class="text-[10px] font-bold text-primary">C#</small>
      </div>
      <pre class="overflow-x-auto p-6 text-[13px] leading-7 text-[#c9c2b8] sm:p-8 sm:text-sm"><code><span class="text-[#c586c0]">using</span> Vanta.Server;

<span class="text-[#c586c0]">public sealed class</span> <span class="text-[#e2bb68]">Main</span> : VantaResource
{'{'}
    <span class="text-[#c586c0]">public override void</span> OnStart()
    {'{'}
        Events.On&lt;Player&gt;(<span class="text-[#95c278]">"playerConnected"</span>, player =&gt;
        {'{'}
            player.Spawn(<span class="text-[#70a8e6]">new</span> Vector3(2495, -1688, 13));
            player.SendMessage(<span class="text-[#95c278]">"Welcome to Vanta."</span>);
        {'}'});
    {'}'}
{'}'}</code></pre>
    </div>
  </div>
</section>
